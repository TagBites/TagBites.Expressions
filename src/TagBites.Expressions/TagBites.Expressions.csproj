<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TagBites</RootNamespace>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>Roslyn-based C# expression parser and evaluator for .NET. Compiles runtime string expressions to strongly typed Func delegates or LINQ expression trees without creating a new assembly.</Description>
    <PackageTags>roslyn; parser; expression; expression-parser; expression-evaluator; expression-trees; lambda-expressions; linq; dynamic-linq; eval; runtime-compilation; formula-parser; rules-engine; delegate</PackageTags>
    <PackageProjectUrl>https://tagbites.com/expressions/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.2.0" />
  </ItemGroup>

  <!-- Usings -->
  <ItemGroup>
    <Using Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
